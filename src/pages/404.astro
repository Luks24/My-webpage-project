---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout pageTitle="Page not found — Luka Kidrič" description="The page you requested could not be found.">
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative flex min-h-[70vh] flex-col items-start justify-center gap-6 py-20">
      <div class="kicker mono"><span>Error 404</span></div>
      <h1 class="text-[clamp(2.6rem,7vw,5rem)] font-bold leading-none tracking-[-0.045em] text-ink">
        This page is <span class="text-accent">not deployed.</span>
      </h1>
      <pre class="mono rounded-md border border-line bg-surface px-4 py-3 !text-[12px] !normal-case !tracking-normal text-mut"><span class="text-faint">$</span> kubectl get page <span class="req-path">this-page</span>
Error from server (NotFound): pages "<span class="req-path">this-page</span>" not found</pre>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button link="/" text="Back home" />
        <Button link="/blog/" text="Read the blog" variant="ghost" />
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.querySelectorAll(".req-path").forEach((el) => (el.textContent = location.pathname));
</script>
