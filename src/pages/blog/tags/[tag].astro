---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/blog/Hero.astro";
import ListPosts from "../../../components/blog/ListPosts.astro";
import Tags from "../../../components/blog/Tags.astro";
import { getTags, getPosts } from "../../../utils/posts";

export function getStaticPaths() {
  return getTags().map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const tagged = getPosts().filter((p) => p.frontmatter.tags?.includes(tag));
---

<Layout pageTitle={`#${tag} — Blog — Luka Kidrič`} description={`Posts tagged ${tag}.`}>
  <Hero
    kicker={`Topic · ${tagged.length} ${tagged.length === 1 ? "post" : "posts"}`}
    title="Posts tagged"
    highlight={` #${tag}`}
  >
    <div class="mt-2"><Tags active={tag} /></div>
  </Hero>
  <section class="wrap py-16 max-md:py-10">
    <div class="max-w-4xl">
      <ListPosts items={tagged} />
      <a href="/blog/posts/" class="mono mt-10 inline-block text-accent transition-colors hover:text-ink">← All posts</a>
    </div>
  </section>
</Layout>
