---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/blog/Hero.astro";
import ListPosts from "../../../components/blog/ListPosts.astro";
import Languages from "../../../components/blog/Languages.astro";
import { getTechs, getPosts } from "../../../utils/posts";
import { getLanguage } from "../../../utils/languages";

export function getStaticPaths() {
  return getTechs().map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const name = getLanguage(category).name;
const matching = getPosts().filter((p) => p.frontmatter.languages?.includes(category));
---

<Layout pageTitle={`${name} — Blog — Luka Kidrič`} description={`Posts about ${name}.`}>
  <Hero
    kicker={`Technology · ${matching.length} ${matching.length === 1 ? "post" : "posts"}`}
    title="Posts about"
    highlight={` ${name}`}
  >
    <div class="mt-2"><Languages /></div>
  </Hero>
  <section class="wrap py-16 max-md:py-10">
    <div class="max-w-4xl">
      <ListPosts items={matching} />
      <a href="/blog/posts/" class="mono mt-10 inline-block text-accent transition-colors hover:text-ink">← All posts</a>
    </div>
  </section>
</Layout>
