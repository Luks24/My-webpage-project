---
import Layout from "./Layout.astro";
import Capsule from "../components/ui/Capsule.astro";
import Tag from "../components/ui/Tag.astro";
import Share from "../components/ui/Share.astro";
import Toc from "../components/layout/Toc.astro";
import ListPosts from "../components/blog/ListPosts.astro";
import { getPosts, findPost, formatDate } from "../utils/posts";
import { getCollection } from "astro:content";

const { frontmatter, headings = [] } = Astro.props;
const [staticData] = await getCollection("staticData");
const { profileImage, linkedin, email } = staticData.data;

const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const posts = getPosts();
const current = findPost(Astro.url.pathname);
const index = current ? posts.indexOf(current) : -1;
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const readingTime = current?.readingTime;
---

<Layout
  pageTitle={`${frontmatter.title} — Luka Kidrič`}
  description={frontmatter.description}
  ogimage={frontmatter.image}
  ogType="article"
>
  <div
    id="read-progress"
    class="fixed top-0 left-0 z-[55] h-0.5 w-full origin-left scale-x-0 bg-accent"
    aria-hidden="true"
  >
  </div>

  <article>
    <header class="relative overflow-hidden border-b border-line">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>
      <div class="wrap relative max-w-6xl pt-14 pb-12"><div class="flex max-w-4xl flex-col gap-6">
        <a href="/blog/" class="mono w-fit text-faint transition-colors hover:text-accent">← Blog</a>
        <div class="flex flex-wrap gap-2">
          {(frontmatter.tags ?? []).map((tag: string) => <Tag tag={tag} />)}
        </div>
        <h1 class="text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.05] tracking-[-0.04em] text-ink text-balance">
          {frontmatter.title}
        </h1>
        {frontmatter.description && <p class="max-w-2xl text-xl leading-relaxed text-mut text-pretty">{frontmatter.description}</p>}
        <div class="mt-2 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-6">
          <div class="flex items-center gap-3">
            <img src={profileImage} alt="" width="40" height="40" class="size-10 rounded-full border border-line object-cover object-top" />
            <div class="flex flex-col">
              <a href="/about-me/" class="text-sm font-semibold text-ink hover:text-accent">{frontmatter.author ?? "Luka Kidrič"}</a>
              <span class="mono text-faint">
                <time datetime={frontmatter.pubDate}>{formatDate(frontmatter.pubDate, "long")}</time>
                {readingTime && <> · {readingTime} min read</>}
              </span>
            </div>
          </div>
          <Share currentUrl={currentUrl} title={frontmatter.title} />
        </div>
      </div></div>
    </header>

    {
      frontmatter.image?.url && (
        <div class="wrap max-w-6xl pt-10">
          <img
            src={frontmatter.image.url}
            alt={frontmatter.image.alt ?? ""}
            class="max-h-[520px] w-full rounded-lg border border-line object-cover"
          />
        </div>
      )
    }

    <div class="wrap grid max-w-6xl gap-16 py-14 xl:grid-cols-[1fr_240px]">
      <div class="w-full min-w-0 max-w-[70ch]">
        <div class="prose" id="content">
          <slot />
        </div>

        {
          (frontmatter.languages ?? []).length > 0 && (
            <div class="mt-14 flex flex-col gap-3 border-t border-line pt-8">
              <span class="mono text-faint">Technologies in this post</span>
              <div class="flex flex-wrap gap-2">
                {frontmatter.languages.map((lang: string) => (
                  <Capsule lang={lang} size="xs" />
                ))}
              </div>
            </div>
          )
        }

        <aside class="mt-10 flex gap-5 rounded-lg border border-line bg-surface p-6 max-sm:flex-col">
          <img src={profileImage} alt="" width="64" height="64" class="size-16 shrink-0 rounded-full border border-line object-cover object-top" />
          <div class="flex flex-col gap-2">
            <span class="mono text-faint">Written by</span>
            <p class="font-semibold text-ink">Luka Kidrič</p>
            <p class="text-[15px] leading-relaxed text-mut">
              SRE engineer at CargoX and Kubestronaut. I write about Kubernetes, Linux and the infrastructure work I do.
              Available for part-time projects.
            </p>
            <div class="mono mt-1 flex flex-wrap gap-4">
              <a href="/about-me/" class="text-accent hover:text-ink">About me →</a>
              <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-ink">LinkedIn ↗</a>
              <a href={`mailto:${email}`} class="text-accent hover:text-ink">Email →</a>
            </div>
          </div>
        </aside>
      </div>

      <aside class="max-xl:hidden">
        <div class="sticky top-24 flex flex-col gap-10">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="wrap max-w-6xl" aria-label="More posts">
        <div class="grid overflow-hidden rounded-lg border border-line sm:grid-cols-2">
          <div class="border-line max-sm:border-b sm:border-r">
            {older && (
              <a href={older.url} class="group flex h-full flex-col gap-2 p-6 transition-colors hover:bg-bg-2">
                <span class="mono text-faint">← Older</span>
                <span class="font-semibold text-ink group-hover:text-accent">{older.frontmatter.title}</span>
              </a>
            )}
          </div>
          <div>
            {newer && (
              <a href={newer.url} class="group flex h-full flex-col items-end gap-2 p-6 text-right transition-colors hover:bg-bg-2">
                <span class="mono text-faint">Newer →</span>
                <span class="font-semibold text-ink group-hover:text-accent">{newer.frontmatter.title}</span>
              </a>
            )}
          </div>
        </div>
      </nav>
    )
  }

  {
    posts.length > 1 && (
      <section class="wrap max-w-6xl py-20">
        <div class="mb-8 flex items-baseline justify-between">
          <h2 class="text-2xl font-bold tracking-tight text-ink">Keep reading</h2>
          <a href="/blog/posts/" class="mono text-accent hover:text-ink">All posts →</a>
        </div>
        <ListPosts variant="card" currentPostUrl={Astro.url.pathname} limit={3} />
      </section>
    )
  }
</Layout>

<script>
  // Reading progress bar
  const bar = document.getElementById("read-progress");
  const article = document.getElementById("content");
  const update = () => {
    if (!bar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.6;
    const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    bar.style.transform = `scaleX(${progress})`;
  };
  window.addEventListener("scroll", update, { passive: true });
  update();

  // Copy buttons on code blocks
  document.querySelectorAll<HTMLPreElement>("#content pre").forEach((pre) => {
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    pre.setAttribute("tabindex", "0");

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1200);
      } catch {}
    });
    wrapper.appendChild(button);
  });
</script>
