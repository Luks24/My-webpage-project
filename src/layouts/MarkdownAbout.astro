---
import Layout from "./Layout.astro";
import Button from "../components/ui/Button.astro";
import Certifications from "../components/portfolio/Certifications.astro";
import Experience from "../components/portfolio/Experience.astro";
import Tools from "../components/portfolio/Tools.astro";
import Contact from "../components/portfolio/Contact.astro";
import { getCollection } from "astro:content";

const { frontmatter } = Astro.props;
const [staticData] = await getCollection("staticData");
const { profileImage, profileAlt, email, hobbies, github, linkedin } = staticData.data;

const facts = [
  { label: "Based in", value: "Slovenia" },
  { label: "Currently", value: "SRE Engineer at CargoX" },
  { label: "Experience", value: "7+ years" },
  { label: "Education", value: "BSc & Master's, first graduate of my university's new master's programme" },
];
---

<Layout pageTitle={frontmatter.title} description={frontmatter.description} ogimage={frontmatter.image}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-12 pt-20 pb-16 max-md:pt-14 lg:grid-cols-[1.4fr_1fr]">
      <div class="flex flex-col gap-6">
        <div class="kicker mono"><span>About me</span></div>
        <h1 class="text-[clamp(2.6rem,6vw,4.25rem)] font-bold leading-[1.02] tracking-[-0.045em] text-ink text-balance">
          Hi, I'm Luka. <span class="text-accent">I like knowing how things work underneath.</span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-mut text-pretty">
          DevOps and SRE engineer with 7+ years of experience, passionate about everything DevOps as well as security.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button link={`mailto:${email}`} text="Get in touch" />
          <Button link={github} text="GitHub" variant="ghost" />
          <Button link={linkedin} text="LinkedIn" variant="ghost" />
        </div>
      </div>
      <figure class="relative mx-auto w-full max-w-xs lg:max-w-sm">
        <div class="overflow-hidden rounded-lg border border-line bg-surface p-2">
          <img src={profileImage} alt={profileAlt} width="918" height="1014" class="aspect-square w-full rounded-md object-cover object-top" />
        </div>
        <span class="absolute -top-3 -left-3 h-6 w-6 border-t border-l border-accent" aria-hidden="true"></span>
        <span class="absolute -right-3 -bottom-3 h-6 w-6 border-r border-b border-accent" aria-hidden="true"></span>
      </figure>
    </div>
  </section>

  <section class="wrap grid gap-16 py-20 max-md:py-14 lg:grid-cols-[1fr_320px]">
    <div class="prose min-w-0" id="content">
      <slot />
    </div>
    <aside class="flex flex-col gap-6 lg:sticky lg:top-24 lg:self-start">
      <dl class="overflow-hidden rounded-lg border border-line">
        {
          facts.map((fact, i) => (
            <div class:list={["flex flex-col gap-1 p-5", i > 0 && "border-t border-line"]}>
              <dt class="mono text-faint">{fact.label}</dt>
              <dd class="text-[15px] text-ink">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="flex flex-col gap-4 rounded-lg border border-line p-5">
        <span class="mono text-faint">Beyond the code</span>
        <ul class="flex flex-wrap gap-2">
          {hobbies.map((hobby) => <li class="rounded-full border border-line px-3 py-1 text-sm text-mut">{hobby}</li>)}
        </ul>
      </div>
    </aside>
  </section>

  <Certifications index="01" />
  <Experience index="02" />
  <Tools index="03" />
  <Contact />
</Layout>
