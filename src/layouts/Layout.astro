---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  pageTitle?: string;
  description?: string;
  ogimage?: { url: string; alt?: string };
  ogType?: "website" | "article";
}

const {
  pageTitle = "Luka Kidrič — DevOps & SRE Engineer",
  description = "Luka Kidrič is a DevOps and SRE engineer and Kubestronaut who builds and runs reliable cloud infrastructure.",
  ogimage = {
    url: "/images/imagedefault.webp",
    alt: "Luka Kidrič — DevOps & SRE Engineer",
  },
  ogType = "website",
} = Astro.props;

const SEO = {
  sitename: "Luka Kidrič",
  locale: "en_US",
  author: "Luka Kidrič",
};

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogimage.url, Astro.site).href;
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <!-- Apply the saved theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.classList.add("js");
      })();
    </script>

    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Luka Kidrič — Blog" href="/rss.xml" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogimage.alt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SEO.sitename} />
    <meta property="og:locale" content={SEO.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogimage.alt} />

    <meta name="theme-color" content="#080c12" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="min-h-screen overflow-x-hidden text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-accent-fill focus:text-accent-on focus:px-4 focus:py-2 mono"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="min-h-[70vh]">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade sections in as they scroll into view
      const items = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px" }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
