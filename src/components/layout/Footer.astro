---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { github, email, linkedin } = staticData.data;

const year = new Date().getFullYear();

const columns = [
  {
    title: "Site",
    links: [
      { name: "Home", href: "/" },
      { name: "Experience", href: "/#experience" },
      { name: "About", href: "/about-me/" },
    ],
  },
  {
    title: "Writing",
    links: [
      { name: "Blog", href: "/blog/" },
      { name: "All posts", href: "/blog/posts/" },
      { name: "RSS feed", href: "/rss.xml" },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { name: "GitHub", href: github },
      { name: "LinkedIn", href: linkedin },
      { name: "Email", href: `mailto:${email}` },
    ],
  },
];
---

<footer class="border-t border-line bg-bg">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="flex flex-col gap-4">
      <a href="/" class="flex items-center gap-3 font-semibold tracking-tight text-ink">
        <span
          class="grid size-8 place-items-center rounded-[6px] border border-line bg-surface font-mono text-[13px] font-semibold text-accent"
          aria-hidden="true">LK</span
        >
        Luka Kidrič
      </a>
      <p class="max-w-xs text-sm leading-relaxed text-mut">
        DevOps &amp; SRE engineer. Kubernetes, AWS, infrastructure as code and observability.
      </p>
      <div class="flex gap-2">
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="grid size-9 place-items-center rounded-md border border-line text-mut transition-colors hover:text-ink hover:border-accent">
          <Icon name="github" class="size-4" aria-hidden="true" />
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid size-9 place-items-center rounded-md border border-line text-mut transition-colors hover:text-ink hover:border-accent">
          <Icon name="linkedin" class="size-4" aria-hidden="true" />
        </a>
        <a href={`mailto:${email}`} aria-label={`Email ${email}`} class="grid size-9 place-items-center rounded-md border border-line text-mut transition-colors hover:text-ink hover:border-accent">
          <Icon name="envelope" class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    {
      columns.map((col) => (
        <div class="flex flex-col gap-4">
          <span class="mono text-faint">{col.title}</span>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  class="text-sm text-mut transition-colors hover:text-ink"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line-soft">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6">
      <span class="mono text-faint">© {year} Luka Kidrič</span>
      <span class="mono text-faint">Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </div>
</footer>
