---
import SectionHeader from "../ui/SectionHeader.astro";
import { SERVICES } from "../../data/profile";
---

<section id="services" class="wrap py-24 max-md:py-16">
  <SectionHeader
    index="01"
    kicker="What I do"
    title="Reliable infrastructure, end to end."
    lead="Whoever builds it should run it. I design platforms, put them into production and stay with them afterwards, with no hand-off to a different team."
  />
  <div class="hairline-grid mt-12 grid-cols-4 max-lg:grid-cols-2 max-sm:grid-cols-1" data-reveal>
    {
      SERVICES.map((service, i) => (
        <div class="group flex flex-col gap-3 p-7 transition-colors hover:!bg-bg-2">
          <div class="mono flex items-center justify-between text-glow">
            <span>{service.label}</span>
            <span class="text-faint">0{i + 1}</span>
          </div>
          <h3 class="mt-6 text-lg font-bold leading-snug tracking-tight text-ink">{service.title}</h3>
          <p class="text-[15px] leading-relaxed text-mut">{service.description}</p>
        </div>
      ))
    }
  </div>
</section>
