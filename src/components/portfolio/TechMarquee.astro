---
import { Icon } from "astro-icon/components";
import { getLanguage } from "../../utils/languages";
import { STACK } from "../../data/profile";

const tools = STACK.flatMap((s) => s.tools).map(getLanguage);
---

<div class="relative overflow-hidden border-b border-line py-6" aria-label="Technologies I work with">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-bg to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-bg to-transparent"
    aria-hidden="true"
  >
  </div>
  <ul class="flex w-max animate-marquee gap-10 hover:[animation-play-state:paused]">
    {
      [...tools, ...tools].map((tool, i) => (
        <li
          class="flex items-center gap-2.5 text-sm text-faint grayscale transition hover:text-ink hover:grayscale-0"
          aria-hidden={i >= tools.length ? "true" : undefined}
        >
          <Icon name={tool.iconName} class="size-5" aria-hidden="true" />
          {tool.name}
        </li>
      ))
    }
  </ul>
</div>
