---
import Button from "../ui/Button.astro";
import { getCollection } from "astro:content";
import { STATS } from "../../data/profile";

const [staticData] = await getCollection("staticData");
const { profileAlt, profileImage, email } = staticData.data;
---

<section id="home" class="relative overflow-hidden border-b border-line" aria-label="Introduction">
  <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] size-[640px] rounded-full blur-3xl"
    style="background: radial-gradient(circle, var(--halo), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative grid items-center gap-14 pt-20 pb-20 max-md:pt-14 lg:grid-cols-[1.35fr_1fr]">
    <div class="flex flex-col gap-7">
      <div class="kicker mono">
        <span>DevOps &amp; SRE Engineer · Slovenia</span>
      </div>

      <h1 class="text-[clamp(2.6rem,6vw,4.5rem)] font-bold leading-[1.02] tracking-[-0.045em] text-ink">
        I build and run cloud infrastructure <span class="text-accent whitespace-nowrap">that stays up.</span>
      </h1>

      <p class="max-w-xl text-lg leading-relaxed text-mut text-pretty">
        I'm Luka, an SRE engineer and Kubestronaut with 7+ years of experience across
        Kubernetes, AWS, infrastructure as code and observability, with a soft spot for security.
      </p>

      <div class="flex flex-wrap gap-3">
        <Button link={`mailto:${email}`} text="Work with me" />
        <Button link="/blog/" text="Read the blog" variant="ghost" />
      </div>

      <div class="flex flex-wrap gap-2 pt-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3 py-1.5 text-sm text-mut">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
          </span>
          <b class="font-semibold text-ink">Available</b> for part-time projects
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3 py-1.5 text-sm text-mut">
          <b class="font-semibold text-ink">Kubestronaut</b> certified
        </span>
      </div>
    </div>

    <figure class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="relative overflow-hidden rounded-lg border border-line bg-surface p-2">
        <img
          src={profileImage}
          alt={profileAlt}
          width="918"
          height="1014"
          class="aspect-[4/4.4] w-full rounded-md object-cover object-top"
          fetchpriority="high"
        />
        <figcaption class="mono flex items-center justify-between px-2 pt-3 pb-1 text-faint">
          <span>Luka Kidrič</span>
          <span class="text-glow">SRE @ CargoX</span>
        </figcaption>
      </div>
      <!-- Corner ticks -->
      <span class="absolute -top-3 -left-3 h-6 w-6 border-t border-l border-accent" aria-hidden="true"></span>
      <span class="absolute -right-3 -bottom-3 h-6 w-6 border-r border-b border-accent" aria-hidden="true"></span>
    </figure>
  </div>

  <div class="relative border-t border-line">
    <dl class="wrap grid grid-cols-3 max-sm:grid-cols-1">
      {
        STATS.map((stat, i) => (
          <div
            class:list={[
              "flex flex-col gap-1 py-7",
              i > 0 && "sm:border-l sm:border-line sm:pl-8 max-sm:border-t max-sm:border-line-soft",
            ]}
          >
            <dt class="mono order-2 text-faint">{stat.label}</dt>
            <dd class="order-1 text-3xl font-bold tracking-tight text-ink">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
