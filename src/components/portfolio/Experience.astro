---
import SectionHeader from "../ui/SectionHeader.astro";
import { EXPERIENCE } from "../../data/profile";

interface Props {
  index?: string;
}
const { index = "03" } = Astro.props;
---

<section id="experience" class="wrap py-24 max-md:py-16">
  <SectionHeader
    index={index}
    kicker="Experience"
    title="From QA automation to SRE."
    lead="Startups, consultancies and Fortune 500 clients, each step a little closer to how systems work underneath."
  />

  <ol class="mt-12 border-t border-line" data-reveal>
    {
      EXPERIENCE.map((job) => (
        <li class="group grid items-start gap-x-10 gap-y-2 border-b border-line py-8 md:grid-cols-[150px_220px_1fr]">
          <div class="mono flex items-center gap-2 pt-1 text-faint">
            {job.current && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />}
            <time>{job.date}</time>
          </div>
          <div>
            <h3 class="text-lg font-bold tracking-tight text-ink">{job.title}</h3>
            <p class="text-accent">{job.company}</p>
          </div>
          <p class="leading-relaxed text-mut">{job.description}</p>
        </li>
      ))
    }
  </ol>
</section>
