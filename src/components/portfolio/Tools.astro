---
import Capsule from "../ui/Capsule.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { STACK } from "../../data/profile";

interface Props {
  index?: string;
}
const { index = "04" } = Astro.props;
---

<section id="stack" class="wrap py-24 max-md:py-16">
  <SectionHeader index={index} kicker="Stack" title="Tools I reach for." />
  <div class="hairline-grid mt-12 grid-cols-3 overflow-hidden rounded-lg max-lg:grid-cols-2 max-sm:grid-cols-1" data-reveal>
    {
      STACK.map((group) => (
        <div class="flex flex-col gap-5 p-7">
          <span class="mono text-faint">{group.group}</span>
          <div class="flex flex-wrap gap-2">
            {group.tools.map((tool) => (
              <Capsule lang={tool} linkEnabled={false} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
