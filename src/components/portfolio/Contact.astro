---
import Button from "../ui/Button.astro";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { email, linkedin } = staticData.data;
---

<section class="relative overflow-hidden border-t border-line">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="wrap relative py-24 max-md:py-16">
    <div class="grid items-end gap-10 md:grid-cols-[1.5fr_1fr]" data-reveal>
      <div class="flex flex-col gap-5">
        <div class="kicker mono"><span>Get in touch</span></div>
        <h2 class="max-w-2xl text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] tracking-[-0.04em] text-ink text-balance">
          Need help with your infrastructure? <span class="text-accent">Let's work together.</span>
        </h2>
        <p class="max-w-xl text-lg text-mut">
          I take on part-time projects: Kubernetes, cloud migrations, CI/CD and monitoring. Send a short note about what you're building.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <Button link={`mailto:${email}`} text="Email me" iconName="envelope" />
        <Button link={linkedin} text="Connect on LinkedIn" variant="ghost" />
        <a href={`mailto:${email}`} class="mono mt-2 text-faint transition-colors hover:text-accent">{email}</a>
      </div>
    </div>
  </div>
</section>
