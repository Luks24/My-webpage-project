---
import { Icon } from "astro-icon/components";
import { getLanguage } from "../../utils/languages";

interface Props {
  lang: string;
  size?: "xs" | "md";
  linkEnabled?: boolean;
}

const { size = "md", lang, linkEnabled = true } = Astro.props as Props;
const language = getLanguage(lang);

const chip = [
  "inline-flex items-center gap-2 rounded-md border border-line bg-surface text-mut",
  size === "xs" ? "py-1 pl-1 pr-2.5 text-xs" : "py-1.5 pl-1.5 pr-3 text-sm",
].join(" ");

const tile = [
  "grid place-items-center rounded-[4px] bg-white p-[3px]",
  size === "xs" ? "size-5" : "size-6",
  language.className ?? "",
].join(" ");
---

{
  linkEnabled ? (
    <a
      href={`/blog/techs/${lang}/`}
      class={`${chip} transition-colors hover:border-accent hover:text-ink`}
      aria-label={`Posts about ${language.name}`}
    >
      <span class={tile} aria-hidden="true">
        <Icon name={language.iconName} class="size-full" />
      </span>
      {language.name}
    </a>
  ) : (
    <span class={chip}>
      <span class={tile} aria-hidden="true">
        <Icon name={language.iconName} class="size-full" />
      </span>
      {language.name}
    </span>
  )
}
