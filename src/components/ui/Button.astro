---
import { Icon } from "astro-icon/components";

interface Props {
  link: string;
  text: string;
  iconName?: string;
  variant?: "primary" | "ghost";
  class?: string;
}

const { link, text, iconName, variant = "primary", class: className = "" } = Astro.props;

const isExternal = link.startsWith("http");

const variants = {
  primary: "bg-accent-fill text-accent-on border-accent-fill hover:opacity-90",
  ghost: "border-line text-ink hover:border-accent hover:text-accent",
};
---

<a
  href={link}
  class:list={[
    "group mono inline-flex items-center justify-center gap-2.5 rounded-md border px-5 py-3.5 !text-xs font-medium transition-all",
    variants[variant],
    className,
  ]}
  {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  {iconName && <Icon name={iconName} class="size-4" aria-hidden="true" />}
  {text}
  <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
</a>
