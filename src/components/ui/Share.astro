---
import { Icon } from "astro-icon/components";

interface Props {
  currentUrl: string;
  title: string;
}

const { currentUrl, title } = Astro.props;
const url = encodeURIComponent(currentUrl);
const text = encodeURIComponent(title);

const links = [
  { name: "LinkedIn", icon: "linkedin", href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}` },
  { name: "X", icon: "twitter", href: `https://twitter.com/intent/tweet?text=${text}&url=${url}` },
];

const btn =
  "grid size-9 place-items-center rounded-md border border-line text-mut transition-colors hover:border-accent hover:text-ink";
---

<div class="flex items-center gap-2" role="group" aria-label="Share this post">
  <span class="mono mr-1 text-faint">Share</span>
  {
    links.map((link) => (
      <a href={link.href} class={btn} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${link.name}`}>
        <Icon name={link.icon} class="size-4" aria-hidden="true" />
      </a>
    ))
  }
  <button type="button" class={`${btn} copy-link cursor-pointer`} data-url={currentUrl} aria-label="Copy link">
    <Icon name="lucide:link" class="size-4" aria-hidden="true" />
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-link").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.url ?? location.href);
        button.setAttribute("aria-label", "Link copied");
        button.classList.add("!border-accent", "!text-accent");
        setTimeout(() => {
          button.setAttribute("aria-label", "Copy link");
          button.classList.remove("!border-accent", "!text-accent");
        }, 1500);
      } catch {}
    });
  });
</script>
