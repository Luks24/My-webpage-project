---
import BlogPost from "./BlogPost.astro";
import { getPosts, type Post } from "../../utils/posts";

export interface Props {
  /** Explicit list to render; defaults to all posts */
  items?: Post[];
  excludeLatest?: boolean;
  currentPostUrl?: string;
  limit?: number;
  variant?: "row" | "card";
}

const { items, excludeLatest = false, currentPostUrl = "", limit, variant = "row" } = Astro.props;

const normalize = (url: string) => url.replace(/\/$/, "");

let list = items ?? getPosts();
if (currentPostUrl) list = list.filter((p) => normalize(p.url) !== normalize(currentPostUrl));
else if (excludeLatest) list = list.slice(1);
if (limit) list = list.slice(0, limit);
---

{
  list.length === 0 ? (
    <p class="border-y border-line py-10 text-mut">No more posts yet. New ones are on the way.</p>
  ) : variant === "card" ? (
    <div class:list={["grid gap-5 md:grid-cols-2", list.length >= 3 && "lg:grid-cols-3"]}>
      {list.map((post) => (
        <BlogPost post={post} variant="card" />
      ))}
    </div>
  ) : (
    <div class="border-t border-line">
      {list.map((post) => (
        <BlogPost post={post} />
      ))}
    </div>
  )
}
