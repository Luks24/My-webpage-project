---
import Tag from "../ui/Tag.astro";
import { getTags, getPosts } from "../../utils/posts";

interface Props {
  active?: string;
  showCounts?: boolean;
}
const { active, showCounts = false } = Astro.props;

const count = (tag: string) => getPosts().filter((p) => p.frontmatter.tags?.includes(tag)).length;
---

<div class="flex flex-wrap gap-2">
  {
    getTags().map((tag) =>
      showCounts ? (
        <a
          href={`/blog/tags/${tag}/`}
          class:list={[
            "mono inline-flex items-center gap-2 rounded-full border px-3 py-1.5 transition-colors",
            tag === active ? "border-accent text-accent" : "border-line text-mut hover:border-accent hover:text-ink",
          ]}
        >
          #{tag} <span class="text-faint">{count(tag)}</span>
        </a>
      ) : (
        <Tag tag={tag} active={tag === active} />
      )
    )
  }
</div>
