---
import type { Post } from "../../utils/posts";
import { formatDate } from "../../utils/posts";

interface Props {
  post: Post;
  /** "row" for lists, "card" for grids */
  variant?: "row" | "card";
}

const { post, variant = "row" } = Astro.props;
const { title, description, pubDate, image, tags = [] } = post.frontmatter;
---

{
  variant === "card" ? (
    <article class="group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-colors hover:border-accent/60">
      {image?.url && (
        <div class="aspect-[16/9] overflow-hidden border-b border-line bg-bg-2">
          <img
            src={image.url}
            alt=""
            loading="lazy"
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
      )}
      <div class="flex flex-1 flex-col gap-3 p-6">
        <p class="mono text-faint">
          <time datetime={pubDate}>{formatDate(pubDate)}</time> · {post.readingTime} min read
        </p>
        <h3 class="text-xl font-bold leading-snug tracking-tight text-ink text-balance">
          <a href={post.url} class="after:absolute after:inset-0 group-hover:text-accent transition-colors">
            {title}
          </a>
        </h3>
        {description && <p class="line-clamp-2 text-[15px] leading-relaxed text-mut">{description}</p>}
        <span class="mono mt-auto pt-3 text-accent">
          Read post <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </span>
      </div>
    </article>
  ) : (
    <article class="group relative grid gap-6 border-b border-line py-8 sm:grid-cols-[1fr_220px] sm:items-center">
      <div class="flex flex-col gap-3">
        <p class="mono text-faint">
          <time datetime={pubDate}>{formatDate(pubDate)}</time> · {post.readingTime} min read
        </p>
        <h3 class="text-2xl font-bold leading-snug tracking-tight text-ink text-balance max-sm:text-xl">
          <a href={post.url} class="after:absolute after:inset-0 group-hover:text-accent transition-colors">
            {title}
          </a>
        </h3>
        {description && <p class="max-w-2xl leading-relaxed text-mut">{description}</p>}
        {tags.length > 0 && (
          <ul class="mono mt-1 flex flex-wrap gap-3 text-faint">
            {tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )}
      </div>
      {image?.url && (
        <div class="aspect-[16/10] overflow-hidden rounded-md border border-line bg-bg-2 max-sm:order-first">
          <img
            src={image.url}
            alt=""
            loading="lazy"
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          />
        </div>
      )}
    </article>
  )
}
