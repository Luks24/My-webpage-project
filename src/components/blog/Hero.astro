---
interface Props {
  kicker?: string;
  title: string;
  highlight?: string;
  lead?: string;
}
const { kicker = "Blog", title, highlight, lead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative flex flex-col gap-6 pt-20 pb-16 max-md:pt-14 max-md:pb-12">
    <div class="kicker mono"><span>{kicker}</span></div>
    <h1 class="max-w-4xl text-[clamp(2.4rem,5.5vw,4rem)] font-bold leading-[1.03] tracking-[-0.045em] text-ink text-balance">
      {title}
      {highlight && <span class="text-accent">{highlight}</span>}
    </h1>
    {lead && <p class="max-w-2xl text-lg leading-relaxed text-mut text-pretty">{lead}</p>}
    <slot />
  </div>
</section>
