---
import Capsule from "../ui/Capsule.astro";
import { getPosts, formatDate } from "../../utils/posts";

const latest = getPosts()[0];
---

{
  latest && (
    <article class="group relative grid overflow-hidden rounded-lg border border-line bg-surface transition-colors hover:border-accent/60 lg:grid-cols-[1.15fr_1fr]">
      {latest.frontmatter.image?.url && (
        <div class="aspect-[16/10] overflow-hidden border-line bg-bg-2 max-lg:border-b lg:aspect-auto lg:border-r">
          <img
            src={latest.frontmatter.image.url}
            alt={latest.frontmatter.image.alt ?? ""}
            class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
        </div>
      )}
      <div class="flex flex-col gap-5 p-10 max-md:p-6">
        <div class="mono flex items-center gap-3">
          <span class="rounded-full border border-accent/50 px-2.5 py-1 text-accent">Latest</span>
          <span class="text-faint">
            <time datetime={latest.frontmatter.pubDate}>{formatDate(latest.frontmatter.pubDate, "long")}</time> ·{" "}
            {latest.readingTime} min read
          </span>
        </div>
        <h2 class="text-[clamp(1.75rem,3vw,2.5rem)] font-bold leading-[1.1] tracking-[-0.03em] text-ink text-balance">
          <a href={latest.url} class="after:absolute after:inset-0 transition-colors group-hover:text-accent">
            {latest.frontmatter.title}
          </a>
        </h2>
        {latest.frontmatter.description && (
          <p class="text-lg leading-relaxed text-mut">{latest.frontmatter.description}</p>
        )}
        <div class="relative z-10 flex flex-wrap gap-2">
          {(latest.frontmatter.languages ?? []).map((lang) => (
            <Capsule lang={lang} size="xs" />
          ))}
        </div>
        <span class="mono mt-auto pt-4 text-accent">
          Read post <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </span>
      </div>
    </article>
  )
}
